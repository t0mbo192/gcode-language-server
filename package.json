{
  "name": "gcode-language-server",
  "displayName": "G-Code Language Server",
  "description": "Semantic diagnostics, hover docs, and completions for CNC G-code. A Python language server with a thin VS Code client.",
  "version": "0.3.0",
  "publisher": "t0mbo192",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/t0mbo192/gcode-language-server.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "gcode",
    "g-code",
    "cnc",
    "nc",
    "machining",
    "linter",
    "fanuc",
    "haas",
    "mazak",
    "siemens",
    "okuma",
    "heidenhain",
    "linuxcnc",
    "marlin",
    "lsp"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:gcode"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The server only reads the text of G-code files and returns diagnostics. It never executes program content, writes files, or opens network connections, and the interpreter path it launches is machine-scoped so a workspace cannot redirect it."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "gcode",
        "aliases": [
          "G-Code",
          "gcode"
        ],
        "extensions": [
          ".nc",
          ".cnc",
          ".ngc",
          ".tap",
          ".gcode",
          ".gc",
          ".mpf",
          ".spf",
          ".eia",
          ".ptp",
          ".min",
          ".din",
          ".iso",
          ".hnc",
          ".ncc",
          ".prg",
          ".i"
        ],
        "filenamePatterns": [
          "O[0-9]*",
          "o[0-9]*"
        ],
        "firstLine": "^%\\s*$",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gcode",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "G-Code Language Server",
      "properties": {
        "gcode.dialect": {
          "type": "string",
          "enum": [
            "auto",
            "fanuc",
            "siemens",
            "linuxcnc",
            "marlin",
            "okuma",
            "mazak",
            "haas",
            "heidenhain",
            "klartext"
          ],
          "default": "auto",
          "description": "Force a G-code dialect for every file. 'auto' picks per file: magic comment '(DIALECT: xxx)' on an early line, then file extension, then Fanuc."
        },
        "gcode.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Path to the Python interpreter used to run the language server (needs pygls installed). Machine-scoped: it can only be set in your own user settings, never by a workspace, because the extension launches it as a process."
        }
      }
    }
  },
  "scripts": {
    "test": "python -m unittest discover -s tests -t tests -v",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run compile",
    "bundle-server": "pyinstaller --noconfirm --clean --onefile --name gcode-ls --distpath server/bin --workpath build --specpath build server/server.py",
    "package:win": "npm run bundle-server && vsce package --target win32-x64",
    "package:universal": "node -e \"require('fs').rmSync('server/bin',{recursive:true,force:true})\" && vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.0"
  }
}
